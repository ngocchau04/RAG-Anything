# Copy this file to .env and replace GEMINI_API_KEY before running.

# Parser: avoid MinerU/LibreOffice dependencies
PARSER=docling
PARSE_METHOD=auto
OUTPUT_DIR=./output
WORKING_DIR=./rag_storage

# Core LLM settings
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
TIMEOUT=240
TEMPERATURE=0
MAX_ASYNC=4
MAX_TOKENS=32768

# Gemini via OpenAI-compatible endpoint
# Docs: https://ai.google.dev/gemini-api/docs/openai
LLM_BINDING=openai
LLM_BINDING_HOST=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BINDING_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-2.0-flash
VISION_MODEL=gemini-2.0-flash

# Embedding (same endpoint, OpenAI-compatible embeddings route)
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_BINDING_API_KEY=YOUR_GEMINI_API_KEY
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
